{
  "root": false,
  "extends": ["../../biome.json"],
  "files": {
    "includes": [
      "!!**/node_modules",
      "!!**/.next",
      "!!**/.turbo",
      "!!**/next-env.d.ts"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["public/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noSvgWithoutTitle": "off"
          }
        }
      }
    }
  ]
}
